{
  "name": "aurea",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.23.5",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:migrate": "pnpm --filter @aurea/db migrate",
    "db:seed:demo": "pnpm --filter @aurea/db seed:demo",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "license-check": "node scripts/check-licenses.mjs",
    "sbom": "node scripts/sbom.mjs",
    "api:start": "pnpm --filter @aurea/api build && pnpm --filter @aurea/api start"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
