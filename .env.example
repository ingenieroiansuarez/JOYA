# Copy is created by `pnpm bootstrap` as .env with random values. Never commit .env.
AUREA_ENV=local
POSTGRES_PORT=5432
POSTGRES_PASSWORD=<generated>
VALKEY_PORT=6379
VALKEY_PASSWORD=<generated>
DATABASE_URL=postgresql://aurea_local:<generated>@127.0.0.1:5432/aurea_local
VALKEY_URL=redis://:<generated>@127.0.0.1:6379
GEOMETRY_WORKER_URL=http://127.0.0.1:3910
GEOMETRY_WORKER_PORT=3910
GEOMETRY_WORKER_SECRET=<generated>
FILE_URL_SECRET=<generated>
ARTIFACT_DIR=<repo>/.data/artifacts
# AURA (hito 400): only the deterministic simulator exists; production refuses it.
AI_PROVIDER=simulated
AI_DAILY_UNITS=30
