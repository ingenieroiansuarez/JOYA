{
  "$comment": "Source of truth for design tokens. packages/tokens generates code from this file and fails CI if a theme pair misses its WCAG 2.2 AA contrast.",
  "version": "1.1.0",
  "color": {
    "obsidian": "#0C0C0D",
    "carbon": "#18181B",
    "graphite": "#29292E",
    "royalGold": "#C5A059",
    "champagne": "#E5CC96",
    "antiqueGold": "#8A6935",
    "ivory": "#F5F0E6",
    "platinum": "#A9A9B0",
    "porcelain": "#FAF9F6",
    "success": "#459B72",
    "warning": "#D6A04D",
    "error": "#D26060",
    "info": "#648EBB"
  },
  "derivedColor": {
    "antiqueGoldDeep": {
      "hex": "#886834",
      "from": "antiqueGold"
    },
    "platinumDeep": {
      "hex": "#6D6D77",
      "from": "platinum"
    },
    "successDeep": {
      "hex": "#367959",
      "from": "success"
    },
    "warningDeep": {
      "hex": "#916521",
      "from": "warning"
    },
    "errorDeep": {
      "hex": "#C73A3A",
      "from": "error"
    },
    "infoDeep": {
      "hex": "#456F9D",
      "from": "info"
    }
  },
  "derivation": "Light theme only: the source color with HSL hue and saturation kept and lightness lowered in 0.5% steps until it reaches 4.5:1 on both porcelain and ivory. Approved by ian on 2026-11-25.",
  "typography": {
    "display": "Cormorant Garamond",
    "body": "Inter",
    "technical": "JetBrains Mono",
    "fallback": "system-ui",
    "scale": [
      12,
      14,
      16,
      20,
      24,
      32,
      40
    ]
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius": [
    8,
    12,
    16
  ],
  "motionMs": [
    150,
    220,
    350
  ],
  "touchTargetDp": 48,
  "themes": {
    "dark": {
      "background": "obsidian",
      "surface": "carbon",
      "text": "ivory",
      "textMuted": "platinum",
      "accent": "royalGold",
      "onAccent": "obsidian",
      "focus": "champagne",
      "inputBorder": "platinum",
      "success": "success",
      "warning": "warning",
      "danger": "error",
      "info": "info"
    },
    "light": {
      "background": "porcelain",
      "surface": "ivory",
      "text": "obsidian",
      "textMuted": "platinumDeep",
      "accent": "antiqueGoldDeep",
      "onAccent": "porcelain",
      "focus": "antiqueGoldDeep",
      "inputBorder": "platinumDeep",
      "success": "successDeep",
      "warning": "warningDeep",
      "danger": "errorDeep",
      "info": "infoDeep"
    }
  },
  "contrast": [
    {
      "rule": "WCAG 2.2 SC 1.4.3 text",
      "min": 4.5,
      "foreground": [
        "text",
        "textMuted",
        "accent",
        "success",
        "warning",
        "danger",
        "info"
      ],
      "background": [
        "background",
        "surface"
      ]
    },
    {
      "rule": "WCAG 2.2 SC 1.4.3 text on accent (buttons)",
      "min": 4.5,
      "foreground": [
        "onAccent"
      ],
      "background": [
        "accent"
      ]
    },
    {
      "rule": "WCAG 2.2 SC 1.4.11 non-text (focus ring, input borders)",
      "min": 3,
      "foreground": [
        "focus",
        "inputBorder"
      ],
      "background": [
        "background",
        "surface"
      ]
    }
  ]
}
