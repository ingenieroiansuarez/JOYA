{
  "name": "@aurea/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL migrations for AUREA (Drizzle migrator over plain SQL).",
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env src/migrate.mjs",
    "test": "node --test test/*.test.mjs",
    "seed:demo": "node --env-file-if-exists=../../.env src/seed-demo.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  }
}
