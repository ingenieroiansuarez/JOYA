{
  "expo": {
    "name": "AUREA (dev)",
    "slug": "aurea",
    "version": "0.1.0",
    "scheme": "com.aurea.customer.dev",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C0D",
    "android": {
      "package": "com.aurea.customer.dev",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-fg.png",
        "monochromeImage": "./assets/brand/adaptive-mono.png",
        "backgroundColor": "#0C0C0D"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C0D",
          "image": "./assets/brand/splash.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-dev-cleartext.js",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/CormorantGaramond_500Medium.ttf",
            "./assets/fonts/CormorantGaramond_600SemiBold.ttf"
          ]
        }
      ]
    ],
    "icon": "./assets/brand/icon.png"
  }
}
