{
  "name": "@aurea/web",
  "version": "0.1.0",
  "private": true,
  "description": "AUREA command center (Next.js): staff panel for quotes, orders and inventory behind a BFF session (OIDC code + PKCE).",
  "scripts": {
    "dev": "node scripts/next.mjs --repo-env dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs --repo-env start --hostname 127.0.0.1 --port 3100",
    "test": "node scripts/next.mjs build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aurea/tokens": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
