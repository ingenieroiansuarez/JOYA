  },
  "dependencies": {
    "@nestjs/common": "12.6.1",
    "@nestjs/core": "12.6.1",
    "@nestjs/platform-express": "12.6.1",
    "ioredis": "6.1.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.6",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
